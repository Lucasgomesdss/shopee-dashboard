# Copie este arquivo para ".env" e preencha depois de criar seu app em open.shopee.com

# Coloque "false" quando já tiver credenciais reais da Shopee.
USE_MOCK_DATA=true

# Encontrados no Console da Shopee Open Platform > seu App
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Não preencha Shop ID / Access Token / Refresh Token aqui — o app salva isso
# sozinho no banco de dados quando você clica em "Authorize" no Console da Shopee.

# Qualquer texto aleatório, usado para proteger a sessão de login
SECRET_KEY=troque-por-um-texto-aleatorio-grande
